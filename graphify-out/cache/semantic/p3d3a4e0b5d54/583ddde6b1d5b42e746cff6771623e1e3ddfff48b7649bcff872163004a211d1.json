{"nodes": [{"id": "report_cep_report", "label": "CEP Report: PSCP Multi-Client Chat (CS-327)", "file_type": "document", "source_file": "report/CEP_Report.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_pscp_protocol", "label": "PSCP (Publish/Subscribe Chat Protocol)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p1 S1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom application-layer protocol designed by the group rather than reusing HTTP/SMTP/DNS; implemented directly on Python sockets to satisfy Option D (multi-client chat with presence)."}, {"id": "report_cep_report_option_d_multi_client_chat", "label": "Option D: Multi-client chat with presence", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p1 S1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_mqtt_v3_1_1", "label": "MQTT v3.1.1 (reference model)", "file_type": "paper", "source_file": "report/CEP_Report.pdf", "source_location": "p1 Table 1; ref [2]", "source_url": "https://docs.oasis-open.org/mqtt/mqtt/v3.1.1/mqtt-v3.1.1.html", "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_broker", "label": "Central Broker (star topology)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p1-2 S2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_rooms_as_topics", "label": "Chat rooms modelled as topics", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p1 S1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_fixed_8_byte_header", "label": "8-byte fixed header (Version, Type, Flags, Topic Len, Message ID, Payload Length)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p2 S2.2 Table 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed-width lengths are simpler to parse and frame than MQTT's variable-length remaining length; version in every message makes each packet self-describing; packed with struct format !BBBBHH big-endian."}, {"id": "report_cep_report_message_types", "label": "PSCP message types (CONNECT..ERROR, 0x01-0x0D)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p2 S2.3 Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_status_codes", "label": "Status and error codes (OK, USERNAME_TAKEN, BAD_VERSION, MALFORMED, NOT_CONNECTED, INVALID_TOPIC, NOT_SUBSCRIBED, SERVER_FULL)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p3 S2.4 Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_client_state_machine", "label": "Client state machine (DISCONNECTED, AWAIT_CONNACK, CONNECTED)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p3 S2.5 Fig 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_qos_levels", "label": "QoS 0 / QoS 1 delivery with DUP retransmission", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p2-3 S2.2, S2.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QoS 2 not needed for chat; QoS 1 PUBLISH unacknowledged within T=2 s is retransmitted with DUP=1 up to 3 times; broker acks but does not re-forward duplicates."}, {"id": "report_cep_report_per_topic_sequence_number", "label": "Per-topic sequence number ordering (room lock)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p1 Table 1; p4 Table 5; p6 S4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MQTT does not guarantee ordering across publishers; broker stamps a per-room sequence number under a per-room lock so publishes to the same room are serialised while different rooms proceed in parallel."}, {"id": "report_cep_report_presence_message", "label": "PRESENCE message on $presence topic (JOIN/LEAVE/TIMEOUT)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p2 Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in presence type instead of MQTT's Last Will emulation."}, {"id": "report_cep_report_keepalive_timers", "label": "Keep-alive PING/PONG timers (K=30 s, dead after 1.5K)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p3 S2.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_worked_example_publish", "label": "Worked example: 15-byte QoS 1 PUBLISH 'Hi' to room1", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p3 S2.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_action_on_receipt", "label": "Action-on-receipt rules (Table 5)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p4 Table 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_three_host_deployment", "label": "Three-host deployment (Broker, Client A, Client B)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p5 S3 Fig 4 Table 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_recv_exact_framing", "label": "recv_exact length-prefixed framing over TCP byte stream", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p6 S4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCP is a byte stream, so receiver reads 8 header bytes then exactly Topic Len + Payload Length bytes to find message boundaries."}, {"id": "report_cep_report_thread_per_client_broker", "label": "Thread-per-client broker with shared client/room tables", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p6 S4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_tcp_transport_choice", "label": "Transport choice: TCP for all message types", "file_type": "rationale", "source_file": "report/CEP_Report.pdf", "source_location": "p6 S4.2 Table 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reliability essential for session setup, chat text and subscriptions; UDP would require custom retransmission, duplicate detection, fragmentation and matching UDP pings to TCP sessions; a TCP ping also proves the chat connection is alive."}, {"id": "report_cep_report_plaintext_security", "label": "Security: plaintext, no authentication (TLS as future work)", "file_type": "rationale", "source_file": "report/CEP_Report.pdf", "source_location": "p6 S4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_encapsulation_analysis", "label": "Wireshark capture and encapsulation analysis (Ethernet/IPv4/TCP/PSCP)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p6-7 S5 Fig 6-7 Table 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_performance_measurement", "label": "Performance measurement: RTT, throughput, chat latency (5 runs)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p8 S6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_measurement_conditions", "label": "Conditions: wired vs Wi-Fi, QoS 0 vs QoS 1, persistent vs per-message connection", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p8 S6.1-6.2 Tables 9-10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_nodal_delay_model", "label": "Nodal delay model (dproc + dqueue + dtrans + dprop)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p8 S6.3 Eq 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_reliability_vs_latency", "label": "Design tension: Reliability vs Latency (QoS 0 vs QoS 1)", "file_type": "rationale", "source_file": "report/CEP_Report.pdf", "source_location": "p9 S7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_compactness_vs_readability", "label": "Design tension: Compactness vs Readability (binary vs JSON)", "file_type": "rationale", "source_file": "report/CEP_Report.pdf", "source_location": "p9 S7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chose 8-byte binary header with Version field so the format can still evolve; JSON equivalent is larger but human-readable."}, {"id": "report_cep_report_state_vs_simplicity", "label": "Design tension: State vs Simplicity (broker in-memory state)", "file_type": "rationale", "source_file": "report/CEP_Report.pdf", "source_location": "p9 S7.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State is unavoidable for presence and ordering, kept only in broker memory; broker crash loses all state and clients must reconnect/resubscribe. Optional: connection reuse vs server resources."}, {"id": "report_cep_report_sustainability_analysis", "label": "Sustainability and efficiency analysis (bytes/msg, kWh/GB)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p9-10 S8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_failure_client_killed", "label": "Failure scenario 1: client killed mid-session (PRESENCE TIMEOUT/LEAVE)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p10 S9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_failure_broker_unreachable", "label": "Failure scenario 2: broker unreachable, exponential back-off (1,2,4,8,16 s)", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p10 S9.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_failure_lost_puback", "label": "Failure scenario 3: lost PUBACK, DUP retransmission", "file_type": "concept", "source_file": "report/CEP_Report.pdf", "source_location": "p10 S9.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_kurose_ross", "label": "Kurose & Ross, Computer Networking: A Top-Down Approach (8th ed.)", "file_type": "paper", "source_file": "report/CEP_Report.pdf", "source_location": "ref [1]", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_python_socket_docs", "label": "Python socket documentation", "file_type": "paper", "source_file": "report/CEP_Report.pdf", "source_location": "ref [3]", "source_url": "https://docs.python.org/3/library/socket.html", "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_rfc_9293_tcp", "label": "RFC 9293 Transmission Control Protocol", "file_type": "paper", "source_file": "report/CEP_Report.pdf", "source_location": "ref [4]", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_cep_report_wireshark_users_guide", "label": "Wireshark Use