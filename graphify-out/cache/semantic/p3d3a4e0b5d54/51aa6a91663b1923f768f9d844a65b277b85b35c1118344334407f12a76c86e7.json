{"nodes": [{"id": "docs_protocol_pscp_v1_spec", "label": "PSCP v1 Specification", "file_type": "document", "source_file": "docs/PROTOCOL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authoritative spec written so another group could build a compatible client or broker from it alone (R1)."}, {"id": "docs_protocol_broker", "label": "Broker (TCP port 5050)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_rooms_topics", "label": "Rooms (Topics)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_fixed_header", "label": "8-byte Fixed Header (!BBBBHH)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed header with explicit 16-bit lengths instead of MQTT variable-length encoding; simple to parse with recv_exact."}, {"id": "docs_protocol_flags_field", "label": "Flags (QoS, DUP, SESSION bits)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_per_room_sequence_number", "label": "Per-room Sequence Number", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broker-assigned under the room lock so ordering is visible to clients; unique only within a room, hence PUBACK carries the room."}, {"id": "docs_protocol_worked_example", "label": "Worked Example (15-byte QoS 1 PUBLISH)", "file_type": "document", "source_file": "docs/PROTOCOL.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_message_types", "label": "PSCP Message Types (CONNECT..ERROR)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_connect", "label": "CONNECT / CONNACK", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_publish", "label": "PUBLISH", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_puback", "label": "PUBACK (carries room + status)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Means the next hop has taken responsibility, not that the user read it."}, {"id": "docs_protocol_ping_pong", "label": "PING / PONG Keep-alive", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_presence", "label": "PRESENCE (JOIN/LEAVE/TIMEOUT, $presence)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in presence with snapshot on subscribe, unlike MQTT which only has Last Will."}, {"id": "docs_protocol_status_codes", "label": "Status Codes (OK..SERVER_FULL)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_connection_states", "label": "Broker Connection States (AWAIT_CONNECT/CONNECTED/CLOSED)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_session_takeover", "label": "Session Takeover", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_qos", "label": "QoS 0 / QoS 1 (both hops)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QoS 1 on both hops so chat is reliable end-to-end; delivery QoS = min(publish QoS, subscription QoS)."}, {"id": "docs_protocol_retransmit", "label": "Retransmit (T=2s, 3 retries, DUP=1)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_duplicate_window", "label": "Duplicate Window (last 256 IDs)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_flow_control", "label": "Flow Control (32 inflight, 1000 queue)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_session_retention", "label": "Session Retention (120 s)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCP loses nothing while up; loss happens when the connection breaks, so the broker keeps state for 120 s to replay. Trade-off: broker memory and state lost on broker crash."}, {"id": "docs_protocol_client_resume", "label": "Client RESUME with Back-off (0,1,2,4,8,16 s)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_timers", "label": "Timers (K=30s, 1.5K dead limit, 0.5s tick)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_tcp_transport", "label": "TCP-only Transport", "file_type": "rationale", "source_file": "docs/PROTOCOL.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UDP pings rejected: second socket, session matching, false timeouts on loss, and TCP ping proves the chat connection itself is alive. Client-initiated TCP also traverses NAT without port forwarding."}, {"id": "docs_protocol_tcp_nodelay", "label": "TCP_NODELAY (disable Nagle)", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small chat messages are not delayed by Nagle's algorithm; matters for latency results."}, {"id": "docs_protocol_recv_exact", "label": "recv_exact framing", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_protocol_mqtt_v3_1_1", "label": "MQTT v3.1.1", "file_type": "concept", "source_file": "docs/PROTOCOL.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used as a reference, not copied; differences listed to show originality (CPA-1)."}], "edges": [{"source": "docs_protocol_pscp_v1_spec", "target": "docs_protocol_mqtt_v3_1_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.